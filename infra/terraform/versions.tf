terraform {
  required_version = ">= 1.8.0"

  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 6.0"
    }
    google-beta = {
      source  = "hashicorp/google-beta"
      version = "~> 6.0"
    }
  }

  # Uncomment and configure a CMEK-encrypted GCS state bucket before production apply:
  # backend "gcs" {
  #   bucket = "your-baa-project-terraform-state"
  #   prefix = "healthcare-risk-platform/prod"
  # }
}

provider "google" {
  project = var.project_id
  region  = var.region
}

provider "google-beta" {
  project = var.project_id
  region  = var.region
}
