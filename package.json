{
  "name": "healthcare-risk-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @healthcare/database migrate",
    "db:seed": "pnpm --filter @healthcare/database seed",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "dev:rules-api": "pnpm --filter @healthcare/rules-engine-api dev",
    "dev:interop": "pnpm --filter @healthcare/interop-ingestion-worker dev",
    "dev:admin": "pnpm --filter @healthcare/admin-portal dev",
    "dev:patient-web": "pnpm --filter @healthcare/patient-web dev",
    "dev:mobile-pwa": "pnpm --filter @healthcare/patient-mobile-pwa dev",
    "dev:provider": "pnpm --filter @healthcare/provider-dashboard dev",
    "test:python": "pytest services/clinical-parser-worker/tests -v && ruff check services/clinical-parser-worker/app services/clinical-parser-worker/tests"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "turbo": "^2.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
